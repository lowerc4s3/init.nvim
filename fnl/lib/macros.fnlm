(local fail (partial assert-compile false))

(lambda str? [x]
  "checks if value's type is string"
  (= :string (type x)))

(lambda num? [x]
  "checks if value's type is number"
  (= :number (type x)))

(lambda assoc [tbl k v]
  (tset tbl k v)
  tbl)

;; TODO: dot and bar macros (bar is tx)
;; see https://blog.spore.ink/editor/fennel-macros/

;; TODO: autocmd-callback macro

(lambda cmd [name]
  "create a command string in form of \":%command<CR>\""
  (assert-compile (str? name) "expected string for name")
  (.. "<Cmd>" name "<CR>"))

(lambda plug [name]
  "create a <Plug>(%name) keymap string"
  (assert-compile (str? name) "expected string for name")
  (.. "<Plug>(" name ")"))

(lambda split-mode-str [modes]
  (icollect [mode (string.gmatch modes ".")] mode))

(lambda merge-opts-with-default [?opts]
  (case ?opts
    nil {:silent true}
    {:silent nil} (assoc ?opts :silent true)
    _ ?opts))

(lambda map [modes lhs rhs ?opts]
  "define a mapping. modes are defined as a string of mode chars.
  if `opts` or `opts.silent` are nil, then silent mapping is inferred"
  (assert-compile (str? modes) "expected string for modes")
  (assert-compile (or (not ?opts) (table? ?opts))
                  "expected table or nil for ?opts")
  (let [opts (merge-opts-with-default ?opts)]
    `(vim.keymap.set ,(split-mode-str modes) ,lhs ,rhs ,opts)))

(lambda gh [repo-name]
  "make a github source link"
  (assert-compile (str? repo-name) "expected string for repo-name")
  (.. "https://github.com/" repo-name))

(lambda cb [repo-name]
  "make a codeberg source link"
  (assert-compile (str? repo-name) "expected string for repo-name")
  (.. "https://codeberg.org/" repo-name))

(lambda tx [& args]
  "mixed sequential and associative tables at compile time.
  macro by olical on github"
  (let [to-merge (when (table? (. args (length args)))
                   (table.remove args))]
    (when to-merge
      (each [key value (pairs to-merge)]
        (tset args key value)))
    args))

(lambda safely [hook & body]
  `((. (require :mini.misc) :safely) ,hook (fn [] ,(unpack body))))

(lambda defhook-on-event [events & body]
  "safely execute body on event with mini-misc.safely"
  (let [event-str (if (sequence? events) (table.concat events ",")
                      (str? events) events
                      (fail "expected string or list of strings for events"))]
    (safely (.. "event:" event-str) (unpack body))))

(lambda defhook-now [& body]
  "safely execute body now with mini-misc.safely"
  (safely :now (unpack body)))

(lambda defhook-defer-for [timeout & body]
  "safely execute body after delay with mini-misc.safely.
  if timeout is &later, then the body will be scheduled immediately,
  otherwise it will be scheduled after specified delay (in ms)"
  (if (= timeout `&later) (safely :later (unpack body))
      (num? timeout) (safely (.. "delay:" timeout) (unpack body))
      (fail "expected &later or number of ms for timeout")))
  
  
(lambda defhook-on-ft [filetypes & body]
  "safely execute body on specified filetypes with mini-misc.safely"
  (let [ft-str (if (sequence? filetypes) (table.concat filetypes ",")
                   (str? filetypes) filetypes
                   (fail "expected string or list of strings for events"))]
    (safely (.. "filetype:" ft-str) (unpack body))))

{: cmd
 : map
 : plug
 : gh
 : cb
 : tx
 : defhook-now
 : defhook-defer-for
 : defhook-on-event
 : defhook-on-ft}
