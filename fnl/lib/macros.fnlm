(lambda assoc [tbl k v]
  (tset tbl k v)
  tbl)

(lambda cmd [command]
  "create a command string in form of \":%command<CR>\""
  (.. :<Cmd> command :<CR>))

(lambda plug [name]
  "create a <Plug>(%name) keymap string"
  (.. "<Plug>(" name ")"))

(lambda split-mode-str [modes]
  (icollect [mode (string.gmatch modes ".")] mode))

(lambda merge-opts-with-default [?opts]
  (case ?opts
    nil {:silent true}
    {:silent nil} (assoc ?opts :silent true)
    _ ?opts))

(lambda map [modes lhs rhs ?opts]
  "define a mapping. modes are defined as a string of mode chars.
  if `opts` or `opts.silent` are nil, then silent mapping is inferred"
  (let [opts (merge-opts-with-default ?opts)]
    `(vim.keymap.set ,(split-mode-str modes) ,lhs ,rhs ,opts)))

(lambda specmap [modes lhs rhs ?opts]
  "define a mapping for `keys` field in the plugin spec.
  modes are defined as a string of mode chars.
  if `opts` or `opts.silent` are nil, then silent mapping is inferred"
  (let [opts (merge-opts-with-default ?opts)]
    (tset opts 1 lhs)
    (tset opts 2 rhs)
    (set opts.modes modes)
    opts))

(lambda gh [name]
  "make a github source link"
  (.. "https://github.com/" name))

(lambda cb [name]
  "make a codeberg source link"
  (.. "https://codeberg.org/" name))

(lambda ! [table fun ...]
  "looks up a function in a table and calls it with provided args.
  acts like a `:` operator but doesn't pass a table as first argument"
  `((. ,table ,fun) ,...))

{: cmd
 : map
 : plug
 : gh
 : cb
 : specmap
 : !}
