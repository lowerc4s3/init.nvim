(local fail (partial assert-compile false))

;;;
;;; comp-time utiliy functions
;;;

(fn type= [t x]
  (= t (type x)))
  
(local ->str tostring)
(local str? (partial type= :string))
(local num? (partial type= :number))

;;;
;;; utility macros
;;;

;; TODO: macro prelude

(λ gh [repo-name]
  "make a github source link"
  (assert-compile (str? repo-name) "expected string for repo-name")
  (.. "https://github.com/" repo-name))

(λ cb [repo-name]
  "make a codeberg source link"
  (assert-compile (str? repo-name) "expected string for repo-name")
  (.. "https://codeberg.org/" repo-name))

;;;
;;; syntax macros
;;;

;; inspired by olical's `tx` macro
;; and spore's `|` macro (https://blog.spore.ink/editor/fennel-macros/bar.html)
(λ | [& args]
  "mixed sequential and associative tables syntax.
all args before associative table are considered sequential elements
and the associative table elements are considered as key-value pairs. so this form
  ```fennel
  (| :fst :sec :trd {:key-a 10 :key-b 20})
  ```
is equivalent to this
  ```fennel
  {1 :fst 2 :sec 3 :trd :key-a 10 :key-b 20}
  ```"
  (let [kv-table (if (table? (. args (length args))) (table.remove args))]
    (when kv-table
      (each [key value (pairs kv-table)]
        (tset args key value)))
    args))

;; idea and implementation by spore
;; (https://blog.spore.ink/editor/fennel-macros/dot.html)
(λ => [expr & calls]
  "method chaining macro. evaluates `expr` chains all consequential forms
into methods calls. behaves similarly to clojure's `..` macro.
example:
  ```fennel
  (dot-> (require :module) (modfn :arg1 :arg2) (another-modfn 3 4))
  ;; notice how this resembles lua method chaining:
  ;; require('module').modfn('arg1, 'arg2').another_modfn(3, 4)
  ```"
  (fn transform [tbl form]
    (case form
      ;; (dot-> tbl form) => (. tbl "form")
      (where field (sym? field)) `(. ,tbl ,(->str field))
      ;; (dot-> tbl [x y]) => (. tbl x y)
      (where fields (sequence? fields)) `(. ,tbl ,(unpack fields))
      ;; (dot-> tbl (f x)) => ((. tbl "f") x)
      [field & rest] `((. ,tbl ,(->str field)) ,(unpack rest))
      ;; (dot-> tbl ()) => (tbl)
      [] `(,tbl)))
  (case calls
    ;; (dot-> expr calls ...) => (dot-> (dot-> expr form) ...)
    [form & rest] (=> (transform expr form) (unpack rest))
    ;; (dot-> expr) => expr
    [] expr))

;;;
;;; neovim api macros
;;;

(λ set^ [opt val]
  "prepend to vim.opt like option"
  `(: ,opt :prepend ,val))

(λ set+ [opt val]
  "append to vim.opt like option"
  `(: ,opt :append ,val))

(λ set- [opt val]
  "remove from vim.opt like option"
  `(: ,opt :remove ,val))

;;;
;;; run macros (mini-misc.safely)
;;;

(λ run-safely [hook & body]
  `((. (require :mini.misc) :safely) ,hook (fn [] ,(unpack body))))

(λ with-event-do [events & body]
  "safely execute body on event with mini-misc.safely"
  (let [event-str (if (sequence? events) (table.concat events ",")
                      (str? events) events
                      (fail "expected string or list of strings for events"))]
    (run-safely (.. "event:" event-str) (unpack body))))

(λ with-safely-do [& body]
  "safely execute body now with mini-misc.safely"
  (run-safely :now (unpack body)))

(λ with-delay-do [timeout & body]
  "safely execute body after delay with mini-misc.safely.
if timeout is &later, then the body will be scheduled immediately,
otherwise it will be scheduled after specified delay (in ms)"
  (if (= timeout `&later) (run-safely :later (unpack body))
      (num? timeout) (run-safely (.. "delay:" timeout) (unpack body))
      (fail "expected &later or number of ms for timeout")))

(λ with-filetype-do [filetypes & body]
  "safely execute body on specified filetypes with mini-misc.safely"
  (let [ft-str (if (sequence? filetypes) (table.concat filetypes ",")
                   (str? filetypes) filetypes
                   (fail "expected string or list of strings for events"))]
    (run-safely (.. "filetype:" ft-str) (unpack body))))

(λ with-safely [hook ...]
  "execute `body` once on certain condition and warn on error.
accepts following hooks:
  - `:now` - run immediately;
  - `:later` - schedule execution with `vim.schedule`;
  - `[:delay timeout] - delay execution for `timeout` ms with `vim.defer_fn`;
  - `[:on-event events ?patterns] - run on one or more events matching patterns;
  - `[:on-filetype filetypes] - run on one or more filetypes`"
  (let [->comma-list #(if (sequence? $) (table.concat $ ",")
                          (str? $) $
                          (fail "expected string or list of strings for value"))
        hook-str (case hook
                   :now :now
                   :later :later
                   [:on-event e p] (.. "event:" (->comma-list e) "~" (->comma-list p))
                   [:on-event e] (.. "event:" (->comma-list e))
                   [:on-filetype ft] (.. "filetype:" (->comma-list ft))
                   _ (fail "invalid hook"))]
    (=> `(require :mini.misc) `(safely ,hook-str (fn [] ,...)))))

{: set^
 : set+
 : set-
 : gh
 : cb
 : |
 : =>
 : with-safely}
